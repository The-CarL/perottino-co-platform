{
  "name": "@perottino-co/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perottino & Co. owner console and employee runtime",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.x"
  },
  "scripts": {
    "setup:owner": "node scripts/init-owner.mjs",
    "setup:browser": "playwright-core install chromium",
    "start": "node src/server.mjs",
    "start:model-worker": "node src/agent.mjs --bedrock-worker",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "synth": "node infra/synth.mjs",
    "synth:hosted": "node infra/synth-hosted.mjs",
    "check": "npm test && npm run synth && npm run synth:hosted && npm run test:smoke"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1178.0",
    "@aws-sdk/client-dynamodb": "3.1178.0",
    "@aws-sdk/client-ecs": "3.1178.0",
    "@aws-sdk/client-lambda": "3.1178.0",
    "@aws-sdk/client-secrets-manager": "3.1178.0",
    "@aws-sdk/client-xray": "3.1178.0",
    "@aws-sdk/lib-dynamodb": "3.1178.0",
    "@openai/codex-sdk": "0.163.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "playwright-core": "1.57.0",
    "postal-mime": "4.2.1"
  },
  "devDependencies": {
    "aws-cdk-lib": "2.221.0",
    "constructs": "10.4.2"
  }
}
